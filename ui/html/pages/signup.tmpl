{{define "title"}}Signup{{end}}

{{define "main"}}
<div class="signup-container">
  <form action='/user/signup' method='POST' novalidate class="signup-form">
    <div class="part">
      <label class="form-label">Name:</label>
      {{with .Form.FieldErrors.name}}
        <label class='error'>{{.}}</label>
      {{end}}
      <input class="form-input" type='text' name='name' value='{{.Form.Name}}'>
    </div>
    <div class="part">
      <label class="form-label">Email:</label>
      {{with .Form.FieldErrors.email}}
        <label class='error'>{{.}}</label>
      {{end}}
      <input class="form-input" type='email' name='email' value='{{.Form.Email}}'>
    </div>
    <div class="part">
      <label class="form-label">Password:</label>
      {{with .Form.FieldErrors.password}}
        <label class='error'>{{.}}</label>
      {{end}}
      <div class="password-wrapper">
        <input class="form-input" type='password' name='password' id='password'>
        <button type="button" class="eye-btn">
          <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </button>
      </div>
    </div>
    <div class="part">
      <input class="form-input" type='submit' value='Signup'>
    </div>
  </form>
</div>
{{end}}